{
  "name": "mysterycase",
  "private": true,
  "scripts": {
    "dev:web": "bun --cwd frontend run dev",
    "dev:api": "bun --cwd backend run dev",
    "build:web": "bun --cwd frontend run build",
    "start:web": "bun --cwd frontend run start",
    "start:api": "bun --cwd backend run start",
    "test": "bun --cwd frontend run test",
    "i": "bun install --cwd frontend && bun install --cwd backend"
  }
}
